{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DustConfig": {
      "additionalProperties": false,
      "description": "Dust (``[network.dust]``); the table enables the dust module.\n\nAttributes\n----------\nrv : float\n    Total-to-selective extinction ratio R_V selecting the tabulated dust\n    model: ``3.1``, ``4.0`` or ``5.5``.\nu_reduction : str\n    Dust cross-section attenuating the radiation density: ``\"extinction\"``,\n    ``\"absorption\"``, ``\"scattering\"``, ``\"transport\"`` or ``\"none\"``.\nf_reduction : str\n    Dust cross-section attenuating the radiation flux (same choices).\npe : PhotoelectricEmissionConfig\n    Photoelectric emission settings.",
      "properties": {
        "rv": {
          "default": 3.1,
          "enum": [
            3.1,
            4.0,
            5.5
          ],
          "title": "Rv",
          "type": "number"
        },
        "u_reduction": {
          "default": "absorption",
          "enum": [
            "extinction",
            "absorption",
            "scattering",
            "transport",
            "none"
          ],
          "title": "U Reduction",
          "type": "string"
        },
        "f_reduction": {
          "default": "transport",
          "enum": [
            "extinction",
            "absorption",
            "scattering",
            "transport",
            "none"
          ],
          "title": "F Reduction",
          "type": "string"
        },
        "pe": {
          "$ref": "#/$defs/PhotoelectricEmissionConfig",
          "default": {
            "threshold_low": 6.0,
            "threshold_high": 13.6
          }
        }
      },
      "title": "DustConfig",
      "type": "object"
    },
    "FermiDegenerateEosConfig": {
      "additionalProperties": false,
      "description": "Non-relativistic degenerate Fermi gas (``type = \"fermi_degenerate\"``).",
      "properties": {
        "type": {
          "const": "fermi_degenerate",
          "default": "fermi_degenerate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FermiDegenerateEosConfig",
      "type": "object"
    },
    "IdealEosConfig": {
      "additionalProperties": false,
      "description": "Ideal-gas EOS (``type = \"ideal\"``).\n\nAttributes\n----------\ngamma : float\n    Adiabatic index, > 1.",
      "properties": {
        "type": {
          "const": "ideal",
          "default": "ideal",
          "title": "Type",
          "type": "string"
        },
        "gamma": {
          "default": 1.6666666666667,
          "exclusiveMinimum": 1.0,
          "title": "Gamma",
          "type": "number"
        }
      },
      "title": "IdealEosConfig",
      "type": "object"
    },
    "MultiGammaEosConfig": {
      "additionalProperties": false,
      "description": "Ideal gas with a per-species adiabatic index (``type = \"multi_gamma\"``).\n\nAttributes\n----------\ndefault_gamma : float\n    Adiabatic index of species absent from ``gamma_map``, > 1.\ngamma_map : dict[str, float]\n    Adiabatic index per species name, each > 1.",
      "properties": {
        "type": {
          "const": "multi_gamma",
          "default": "multi_gamma",
          "title": "Type",
          "type": "string"
        },
        "default_gamma": {
          "exclusiveMinimum": 1.0,
          "title": "Default Gamma",
          "type": "number"
        },
        "gamma_map": {
          "additionalProperties": {
            "exclusiveMinimum": 1.0,
            "type": "number"
          },
          "title": "Gamma Map",
          "type": "object"
        }
      },
      "required": [
        "default_gamma",
        "gamma_map",
        "type"
      ],
      "title": "MultiGammaEosConfig",
      "type": "object"
    },
    "NetworkConfig": {
      "additionalProperties": false,
      "description": "Network (``[network]``).\n\nAttributes\n----------\nlabel : str or None\n    Human-readable network name; ``None`` uses the network file stem.\nstrict : bool\n    Treat validation problems (conservation, sinks/sources, ...) as fatal.\nfuncfile : bool or Path\n    ``.jfunc`` auxiliary file: ``True`` looks next to the network file,\n    ``False`` loads none, a path names it.\nexpand_nuclei : bool\n    Expand ``n_<element>_nuc`` into the element-nucleus sum.\nreactions : ReactionsConfig\n    Settings of the reactions.\nradiation : RadiationConfig or None\n    Radiation field; ``None`` disables radiation.\ndust : DustConfig or None\n    Dust; ``None`` disables the dust module.\nthermodynamics : ThermodynamicsConfig\n    Thermodynamics.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "strict": {
          "default": false,
          "title": "Strict",
          "type": "boolean"
        },
        "funcfile": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "path",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Funcfile"
        },
        "expand_nuclei": {
          "default": true,
          "title": "Expand Nuclei",
          "type": "boolean"
        },
        "reactions": {
          "$ref": "#/$defs/ReactionsConfig",
          "default": {
            "duplicate_policy": "preserve-first",
            "t_cutoff": "clip",
            "photo": {
              "override_custom_cross_section": false,
              "override_custom_rate": false,
              "pi_database": "norad",
              "shielding": null,
              "use_proxy_photoreaction": true
            },
            "reaction": {}
          }
        },
        "radiation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RadiationConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dust": {
          "anyOf": [
            {
              "$ref": "#/$defs/DustConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thermodynamics": {
          "$ref": "#/$defs/ThermodynamicsConfig",
          "default": {
            "eos": {
              "gamma": 1.6666666666667,
              "type": "ideal"
            }
          }
        }
      },
      "title": "NetworkConfig",
      "type": "object"
    },
    "PhotoConfig": {
      "additionalProperties": false,
      "description": "Photo-reaction settings (``[network.reactions.photo]``).\n\nAttributes\n----------\npi_database : str or None\n    Photoionisation cross-section database: ``\"norad\"``, ``\"verner\"`` or\n    ``\"leiden\"``.\noverride_custom_rate : bool or None\n    Recompute a ``.jfunc`` ``chemRate<N>`` rate from the cross sections.\noverride_custom_cross_section : bool or None\n    Ignore ``.jfunc`` ``photoCrossSection<N>`` and use the database.\nuse_proxy_photoreaction : bool or None\n    Look cross sections up under the proxy reaction (``CHx`` → ``CH``).\nshielding : ShieldingConfig or None\n    Line shielding of the rate; ``None`` globally means no shielding.\n\n``None`` means unset: the value comes from the global settings.",
      "properties": {
        "pi_database": {
          "anyOf": [
            {
              "enum": [
                "norad",
                "verner",
                "leiden"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pi Database"
        },
        "override_custom_rate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Custom Rate"
        },
        "override_custom_cross_section": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Custom Cross Section"
        },
        "use_proxy_photoreaction": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Proxy Photoreaction"
        },
        "shielding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShieldingConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PhotoConfig",
      "type": "object"
    },
    "PhotoelectricEmissionConfig": {
      "additionalProperties": false,
      "description": "Photoelectric emission of the dust (``[network.dust.pe]``).\n\nAttributes\n----------\nthreshold_low : float\n    Lower edge of the photoelectric band in eV (grain work function).\nthreshold_high : float\n    Upper edge of the photoelectric band in eV.",
      "properties": {
        "threshold_low": {
          "default": 6.0,
          "title": "Threshold Low",
          "type": "number"
        },
        "threshold_high": {
          "default": 13.6,
          "title": "Threshold High",
          "type": "number"
        }
      },
      "title": "PhotoelectricEmissionConfig",
      "type": "object"
    },
    "RadiationConfig": {
      "additionalProperties": false,
      "description": "Radiation field (``[network.radiation]``); the table enables radiation.\n\nOnly the shape of the settings is checked here; whether the band-averaged\nspectrum converges is checked by the radiation field itself.\n\nAttributes\n----------\nbands : list of (float or \"inf\")\n    Ordered photon-energy band edges in eV, at least two; ``\"inf\"`` is\n    allowed as the last edge only.\nprofile_index : float or list of float\n    Spectral index *α* of the photon-number spectrum ``n(E) ∝ E^(α-2)``:\n    one for every band, or a list with one per band.\nmode : str\n    Tracked quantity: ``\"nph\"`` (photon number density) or ``\"u\"``\n    (energy density).\nc : float or str\n    Speed of light in cm/s, or a symbol name (e.g. ``\"c_hat\"``) for a\n    reduced speed of light.\nbackground_field : str\n    Reference radiation field used to scale ``chi_pe``.\nabsorption_attenuates_flux : bool\n    Whether the ``globalAbsorptionCoefficient`` also attenuates the flux\n    equations, not only the density equations.",
      "properties": {
        "bands": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "const": "inf",
                "type": "string"
              }
            ]
          },
          "title": "Bands",
          "type": "array"
        },
        "profile_index": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.0,
          "title": "Profile Index"
        },
        "mode": {
          "default": "nph",
          "enum": [
            "nph",
            "u"
          ],
          "title": "Mode",
          "type": "string"
        },
        "c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 29979245800.0,
          "title": "C"
        },
        "background_field": {
          "default": "draine",
          "enum": [
            "bb_4000",
            "bb_10000",
            "bb_20000",
            "draine",
            "habing",
            "mathis",
            "solar",
            "tw_hydra"
          ],
          "title": "Background Field",
          "type": "string"
        },
        "absorption_attenuates_flux": {
          "default": true,
          "title": "Absorption Attenuates Flux",
          "type": "boolean"
        }
      },
      "required": [
        "bands"
      ],
      "title": "RadiationConfig",
      "type": "object"
    },
    "ReactionConfig": {
      "additionalProperties": false,
      "description": "Settings of one reaction (``[network.reactions.reaction.\"<serialized>\"]``).\n\nAttributes\n----------\nduplicate_policy : str or None\n    How two rate coefficients over the same temperature range are\n    resolved: ``\"preserve-first\"``, ``\"preserve-last\"`` or ``\"error\"``.\nt_cutoff : str or None\n    Rate behaviour outside the temperature range: ``\"clip\"`` or\n    ``\"extrapolate\"``.\nphoto : PhotoConfig or None\n    Photo-reaction settings.\n\n``None`` means unset: the value comes from the global settings.",
      "properties": {
        "duplicate_policy": {
          "anyOf": [
            {
              "enum": [
                "preserve-first",
                "preserve-last",
                "error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Policy"
        },
        "t_cutoff": {
          "anyOf": [
            {
              "enum": [
                "clip",
                "extrapolate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Cutoff"
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhotoConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ReactionConfig",
      "type": "object"
    },
    "ReactionsConfig": {
      "additionalProperties": false,
      "description": "Settings of every reaction (``[network.reactions]``).\n\nHolds the same keys as :class:`ReactionConfig`, with concrete defaults,\nplus the per-reaction entries.\n\nAttributes\n----------\nreaction : dict[str, ReactionConfig]\n    Per-reaction settings keyed by serialized reaction; a key set here\n    wins over the global one (see :meth:`resolve`).",
      "properties": {
        "duplicate_policy": {
          "default": "preserve-first",
          "enum": [
            "preserve-first",
            "preserve-last",
            "error"
          ],
          "title": "Duplicate Policy",
          "type": "string"
        },
        "t_cutoff": {
          "default": "clip",
          "enum": [
            "clip",
            "extrapolate"
          ],
          "title": "T Cutoff",
          "type": "string"
        },
        "photo": {
          "$ref": "#/$defs/PhotoConfig",
          "default": {
            "pi_database": "norad",
            "override_custom_rate": false,
            "override_custom_cross_section": false,
            "use_proxy_photoreaction": true,
            "shielding": null
          }
        },
        "reaction": {
          "additionalProperties": {
            "$ref": "#/$defs/ReactionConfig"
          },
          "default": {},
          "title": "Reaction",
          "type": "object"
        }
      },
      "title": "ReactionsConfig",
      "type": "object"
    },
    "RelativisticFermiDegenerateEosConfig": {
      "additionalProperties": false,
      "description": "Relativistic degenerate Fermi gas (``type = \"relativistic_fermi_degenerate\"``).",
      "properties": {
        "type": {
          "const": "relativistic_fermi_degenerate",
          "default": "relativistic_fermi_degenerate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "RelativisticFermiDegenerateEosConfig",
      "type": "object"
    },
    "ShieldingConfig": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "db1996"
            },
            "min_ncol": {
              "default": 1e-50,
              "title": "Min Ncol",
              "type": "number"
            },
            "min_vdisp": {
              "default": 1e-50,
              "title": "Min Vdisp",
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "title": "db1996 shielding (only for H2._PHOTON__H.H)",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "hg2015"
            },
            "min_ncol": {
              "default": 1e-50,
              "title": "Min Ncol",
              "type": "number"
            },
            "min_vdisp": {
              "default": 1e-50,
              "title": "Min Vdisp",
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "title": "hg2015 shielding (only for H2._PHOTON__H.H)",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "leiden"
            },
            "shielded_by": {
              "items": {
                "enum": [
                  "H2",
                  "H",
                  "C",
                  "N2",
                  "CO",
                  "self"
                ],
                "type": "string"
              },
              "title": "Shielded By",
              "type": "array"
            },
            "radiation": {
              "default": "isrf",
              "title": "Radiation",
              "type": "string"
            }
          },
          "required": [
            "shielded_by"
          ],
          "title": "leiden shielding",
          "type": "object"
        }
      ],
      "description": "Line shielding of a photo reaction; `type` selects the model (default 'leiden') and its keys.",
      "title": "Shielding"
    },
    "ThermodynamicsConfig": {
      "additionalProperties": false,
      "description": "Thermodynamics (``[network.thermodynamics]``).\n\nAttributes\n----------\neos : EosConfig\n    Equation of state; its ``type`` selects the model and its keys.",
      "properties": {
        "eos": {
          "default": {
            "type": "ideal",
            "gamma": 1.6666666666667
          },
          "oneOf": [
            {
              "$ref": "#/$defs/IdealEosConfig"
            },
            {
              "$ref": "#/$defs/MultiGammaEosConfig"
            },
            {
              "$ref": "#/$defs/FermiDegenerateEosConfig"
            },
            {
              "$ref": "#/$defs/RelativisticFermiDegenerateEosConfig"
            }
          ],
          "title": "Eos"
        }
      },
      "title": "ThermodynamicsConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A ``jaff.toml`` file: the settings of the network next to it.",
  "properties": {
    "network": {
      "$ref": "#/$defs/NetworkConfig",
      "default": {
        "label": null,
        "strict": false,
        "funcfile": true,
        "expand_nuclei": true,
        "reactions": {
          "duplicate_policy": "preserve-first",
          "photo": {
            "override_custom_cross_section": false,
            "override_custom_rate": false,
            "pi_database": "norad",
            "shielding": null,
            "use_proxy_photoreaction": true
          },
          "reaction": {},
          "t_cutoff": "clip"
        },
        "radiation": null,
        "dust": null,
        "thermodynamics": {
          "eos": {
            "gamma": 1.6666666666667,
            "type": "ideal"
          }
        }
      }
    }
  },
  "title": "JaffTomlConfig",
  "type": "object"
}
