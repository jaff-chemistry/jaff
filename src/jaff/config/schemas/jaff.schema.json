{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DustConfig": {
      "additionalProperties": false,
      "description": "Dust (`[network.dust]`); the table enables the dust module.",
      "properties": {
        "rv": {
          "default": 3.1,
          "description": "Total-to-selective extinction ratio R_V selecting the tabulated dust model: `3.1`, `4.0` or `5.5`.",
          "enum": [
            3.1,
            4.0,
            5.5
          ],
          "title": "Rv",
          "type": "number"
        },
        "u_reduction": {
          "default": "absorption",
          "description": "Dust cross-section attenuating the radiation density: `\"extinction\"`, `\"absorption\"`, `\"scattering\"`, `\"transport\"` or `\"none\"`.",
          "enum": [
            "extinction",
            "absorption",
            "scattering",
            "transport",
            "none"
          ],
          "title": "U Reduction",
          "type": "string"
        },
        "f_reduction": {
          "default": "transport",
          "description": "Dust cross-section attenuating the radiation flux (same choices).",
          "enum": [
            "extinction",
            "absorption",
            "scattering",
            "transport",
            "none"
          ],
          "title": "F Reduction",
          "type": "string"
        },
        "pe": {
          "$ref": "#/$defs/PhotoelectricEmissionConfig",
          "default": {
            "threshold_low": 6.0,
            "threshold_high": 13.6
          },
          "description": "Photoelectric emission settings."
        }
      },
      "title": "DustConfig",
      "type": "object"
    },
    "FermiDegenerateEosConfig": {
      "additionalProperties": false,
      "description": "Non-relativistic degenerate Fermi gas (`type = \"fermi_degenerate\"`).",
      "properties": {
        "type": {
          "const": "fermi_degenerate",
          "default": "fermi_degenerate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FermiDegenerateEosConfig",
      "type": "object"
    },
    "IdealEosConfig": {
      "additionalProperties": false,
      "description": "Ideal-gas EOS (`type = \"ideal\"`).",
      "properties": {
        "type": {
          "const": "ideal",
          "default": "ideal",
          "title": "Type",
          "type": "string"
        },
        "gamma": {
          "default": 1.6666666666667,
          "description": "Adiabatic index, > 1.",
          "exclusiveMinimum": 1.0,
          "title": "Gamma",
          "type": "number"
        }
      },
      "title": "IdealEosConfig",
      "type": "object"
    },
    "MultiGammaEosConfig": {
      "additionalProperties": false,
      "description": "Ideal gas with a per-species adiabatic index (`type = \"multi_gamma\"`).",
      "properties": {
        "type": {
          "const": "multi_gamma",
          "default": "multi_gamma",
          "title": "Type",
          "type": "string"
        },
        "default_gamma": {
          "description": "Adiabatic index of species absent from `gamma_map`, > 1.",
          "exclusiveMinimum": 1.0,
          "title": "Default Gamma",
          "type": "number"
        },
        "gamma_map": {
          "additionalProperties": {
            "exclusiveMinimum": 1.0,
            "type": "number"
          },
          "description": "Adiabatic index per species name, each > 1.",
          "title": "Gamma Map",
          "type": "object"
        }
      },
      "required": [
        "default_gamma",
        "gamma_map",
        "type"
      ],
      "title": "MultiGammaEosConfig",
      "type": "object"
    },
    "NetworkConfig": {
      "additionalProperties": false,
      "description": "Network (`[network]`).",
      "properties": {
        "label": {
          "type": "string",
          "description": "Human-readable network name; without it, the network file stem.",
          "title": "Label"
        },
        "strict": {
          "default": false,
          "description": "Treat validation problems (conservation, sinks/sources, ...) as fatal.",
          "title": "Strict",
          "type": "boolean"
        },
        "funcfile": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "path",
              "type": "string"
            }
          ],
          "default": true,
          "description": "`.jfunc` auxiliary file: `true` looks next to the network file, `false` loads none, a path names it.",
          "title": "Funcfile"
        },
        "expand_nuclei": {
          "default": true,
          "description": "Expand `n_<element>_nuc` into the element-nucleus sum.",
          "title": "Expand Nuclei",
          "type": "boolean"
        },
        "reactions": {
          "$ref": "#/$defs/ReactionsConfig",
          "default": {
            "duplicate_policy": "preserve-first",
            "t_cutoff": "clip",
            "photo": {
              "override_custom_cross_section": false,
              "override_custom_rate": false,
              "pi_database": "norad",
              "shielding": null,
              "use_proxy_photoreaction": true
            },
            "reaction": {}
          },
          "description": "Settings of the reactions."
        },
        "radiation": {
          "$ref": "#/$defs/RadiationConfig",
          "description": "Radiation field; the table enables radiation."
        },
        "dust": {
          "$ref": "#/$defs/DustConfig",
          "description": "Dust; the table enables the dust module."
        },
        "thermodynamics": {
          "$ref": "#/$defs/ThermodynamicsConfig",
          "default": {
            "eos": {
              "gamma": 1.6666666666667,
              "type": "ideal"
            }
          },
          "description": "Thermodynamics."
        }
      },
      "title": "NetworkConfig",
      "type": "object"
    },
    "PhotoConfig": {
      "additionalProperties": false,
      "description": "Photo-reaction settings (`[network.reactions.photo]`).\n\n`None` means unset: the value comes from the global settings.",
      "properties": {
        "pi_database": {
          "enum": [
            "norad",
            "verner",
            "leiden"
          ],
          "type": "string",
          "description": "Photoionisation cross-section database: `\"norad\"`, `\"verner\"` or `\"leiden\"`.",
          "title": "Pi Database"
        },
        "override_custom_rate": {
          "type": "boolean",
          "description": "Recompute a `.jfunc` `chemRate<N>` rate from the cross sections.",
          "title": "Override Custom Rate"
        },
        "override_custom_cross_section": {
          "type": "boolean",
          "description": "Ignore `.jfunc` `photoCrossSection<N>` and use the database.",
          "title": "Override Custom Cross Section"
        },
        "use_proxy_photoreaction": {
          "type": "boolean",
          "description": "Look cross sections up under the proxy reaction (`CHx` → `CH`).",
          "title": "Use Proxy Photoreaction"
        },
        "shielding": {
          "$ref": "#/$defs/ShieldingConfig",
          "description": "Line shielding of the rate; without it, the rate is not shielded."
        }
      },
      "title": "PhotoConfig",
      "type": "object"
    },
    "PhotoelectricEmissionConfig": {
      "additionalProperties": false,
      "description": "Photoelectric emission of the dust (`[network.dust.pe]`).",
      "properties": {
        "threshold_low": {
          "default": 6.0,
          "description": "Lower edge of the photoelectric band in eV (grain work function).",
          "title": "Threshold Low",
          "type": "number"
        },
        "threshold_high": {
          "default": 13.6,
          "description": "Upper edge of the photoelectric band in eV, above `threshold_low`.",
          "title": "Threshold High",
          "type": "number"
        }
      },
      "title": "PhotoelectricEmissionConfig",
      "type": "object"
    },
    "RadiationConfig": {
      "additionalProperties": false,
      "description": "Radiation field (`[network.radiation]`); the table enables radiation.\n\nOnly the shape of the settings is checked here; whether the band-averaged\nspectrum converges is checked by the radiation field itself.",
      "properties": {
        "bands": {
          "description": "Increasing photon-energy band edges in eV, at least two; `\"inf\"` is allowed as the last edge only.",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "const": "inf",
                "type": "string"
              }
            ]
          },
          "title": "Bands",
          "type": "array"
        },
        "profile_index": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "Spectral index *α* of the photon-number spectrum `n(E) ∝ E^(α-2)`: one for every band, or a list with one per band.",
          "title": "Profile Index"
        },
        "mode": {
          "default": "nph",
          "description": "Tracked quantity: `\"nph\"` (photon number density) or `\"u\"` (energy density).",
          "enum": [
            "nph",
            "u"
          ],
          "title": "Mode",
          "type": "string"
        },
        "c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 29979245800.0,
          "description": "Speed of light in cm/s, or a symbol name (e.g. `\"c_hat\"`) for a reduced speed of light.",
          "title": "C"
        },
        "background_field": {
          "default": "draine",
          "description": "Reference radiation field used to scale `chi_pe`.",
          "enum": [
            "bb_4000",
            "bb_10000",
            "bb_20000",
            "draine",
            "habing",
            "mathis",
            "solar",
            "tw_hydra"
          ],
          "title": "Background Field",
          "type": "string"
        },
        "absorption_attenuates_flux": {
          "default": true,
          "description": "Whether the `globalAbsorptionCoefficient` also attenuates the flux equations, not only the density equations.",
          "title": "Absorption Attenuates Flux",
          "type": "boolean"
        }
      },
      "required": [
        "bands"
      ],
      "title": "RadiationConfig",
      "type": "object"
    },
    "ReactionConfig": {
      "additionalProperties": false,
      "description": "Settings of one reaction (`[network.reactions.reaction.\"<serialized>\"]`).\n\n`None` means unset: the value comes from the global settings.",
      "properties": {
        "duplicate_policy": {
          "enum": [
            "preserve-first",
            "preserve-last",
            "error"
          ],
          "type": "string",
          "description": "How two rate coefficients over the same temperature range are resolved: `\"preserve-first\"`, `\"preserve-last\"` or `\"error\"`.",
          "title": "Duplicate Policy"
        },
        "t_cutoff": {
          "enum": [
            "clip",
            "extrapolate"
          ],
          "type": "string",
          "description": "Rate behaviour outside the temperature range: `\"clip\"` or `\"extrapolate\"`.",
          "title": "T Cutoff"
        },
        "photo": {
          "$ref": "#/$defs/PhotoConfig",
          "description": "Photo-reaction settings."
        }
      },
      "title": "ReactionConfig",
      "type": "object"
    },
    "ReactionsConfig": {
      "additionalProperties": false,
      "description": "Settings of the reactions (`[network.reactions]`).\n\nEach key applies to every reaction, unless a reaction's own table\n(`reaction.\"<serialized>\"`) sets it.",
      "properties": {
        "duplicate_policy": {
          "default": "preserve-first",
          "description": "How two rate coefficients over the same temperature range are resolved: `\"preserve-first\"`, `\"preserve-last\"` or `\"error\"`.",
          "enum": [
            "preserve-first",
            "preserve-last",
            "error"
          ],
          "title": "Duplicate Policy",
          "type": "string"
        },
        "t_cutoff": {
          "default": "clip",
          "description": "Rate behaviour outside the temperature range: `\"clip\"` or `\"extrapolate\"`.",
          "enum": [
            "clip",
            "extrapolate"
          ],
          "title": "T Cutoff",
          "type": "string"
        },
        "photo": {
          "$ref": "#/$defs/PhotoConfig",
          "default": {
            "pi_database": "norad",
            "override_custom_rate": false,
            "override_custom_cross_section": false,
            "use_proxy_photoreaction": true,
            "shielding": null
          },
          "description": "Photo-reaction settings."
        },
        "reaction": {
          "additionalProperties": {
            "$ref": "#/$defs/ReactionConfig"
          },
          "default": {},
          "description": "Per-reaction settings keyed by serialized reaction; a key set there wins over the same key here.",
          "title": "Reaction",
          "type": "object"
        }
      },
      "title": "ReactionsConfig",
      "type": "object"
    },
    "RelativisticFermiDegenerateEosConfig": {
      "additionalProperties": false,
      "description": "Relativistic degenerate Fermi gas (`type = \"relativistic_fermi_degenerate\"`).",
      "properties": {
        "type": {
          "const": "relativistic_fermi_degenerate",
          "default": "relativistic_fermi_degenerate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "RelativisticFermiDegenerateEosConfig",
      "type": "object"
    },
    "ShieldingConfig": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "db1996"
            },
            "min_ncol": {
              "default": 1e-50,
              "description": "Lower floor on the H2 column density (cm^-2).",
              "title": "Min Ncol",
              "type": "number"
            },
            "min_vdisp": {
              "default": 1e-50,
              "description": "Lower floor on the velocity dispersion (cm/s).",
              "title": "Min Vdisp",
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "title": "db1996 shielding (only for H2._PHOTON__H.H)",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "hg2015"
            },
            "min_ncol": {
              "default": 1e-50,
              "description": "Lower floor on the H2 column density (cm^-2).",
              "title": "Min Ncol",
              "type": "number"
            },
            "min_vdisp": {
              "default": 1e-50,
              "description": "Lower floor on the velocity dispersion (cm/s).",
              "title": "Min Vdisp",
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "title": "hg2015 shielding (only for H2._PHOTON__H.H)",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "leiden"
            },
            "shielded_by": {
              "description": "Shielding species, `\"self\"` being the reaction's own reactant; their factors multiply.",
              "items": {
                "enum": [
                  "H2",
                  "H",
                  "C",
                  "N2",
                  "CO",
                  "self"
                ],
                "type": "string"
              },
              "title": "Shielded By",
              "type": "array"
            },
            "radiation": {
              "default": "isrf",
              "description": "Radiation-field subgroup of the Leiden table (case-insensitive).",
              "title": "Radiation",
              "type": "string"
            }
          },
          "required": [
            "shielded_by"
          ],
          "title": "leiden shielding",
          "type": "object"
        }
      ],
      "description": "Line shielding of a photo reaction; `type` selects the model (default 'leiden') and its keys.",
      "title": "Shielding"
    },
    "ThermodynamicsConfig": {
      "additionalProperties": false,
      "description": "Thermodynamics (`[network.thermodynamics]`).",
      "properties": {
        "eos": {
          "default": {
            "type": "ideal",
            "gamma": 1.6666666666667
          },
          "description": "Equation of state; its `type` selects the model and its keys.",
          "oneOf": [
            {
              "$ref": "#/$defs/IdealEosConfig"
            },
            {
              "$ref": "#/$defs/MultiGammaEosConfig"
            },
            {
              "$ref": "#/$defs/FermiDegenerateEosConfig"
            },
            {
              "$ref": "#/$defs/RelativisticFermiDegenerateEosConfig"
            }
          ],
          "title": "Eos"
        }
      },
      "title": "ThermodynamicsConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A `jaff.toml` file: the settings of the network next to it.",
  "properties": {
    "network": {
      "$ref": "#/$defs/NetworkConfig",
      "default": {
        "label": null,
        "strict": false,
        "funcfile": true,
        "expand_nuclei": true,
        "reactions": {
          "duplicate_policy": "preserve-first",
          "photo": {
            "override_custom_cross_section": false,
            "override_custom_rate": false,
            "pi_database": "norad",
            "shielding": null,
            "use_proxy_photoreaction": true
          },
          "reaction": {},
          "t_cutoff": "clip"
        },
        "radiation": null,
        "dust": null,
        "thermodynamics": {
          "eos": {
            "gamma": 1.6666666666667,
            "type": "ideal"
          }
        }
      }
    }
  },
  "title": "JaffTomlConfig",
  "type": "object"
}
